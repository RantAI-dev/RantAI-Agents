// ===== DESIGN PORT (open-design) =====
// Ported 1:1 from the open-design daemon's better-sqlite3 schema:
//   apps/daemon/src/db.ts, library-store.ts, critique/persistence.ts,
//   plugins/persistence.ts, media/tasks.ts, registry/database-backend.ts.
// Conventions:
//   * Every model is Od*-prefixed and @@map("od_<original_table>") so nothing
//     collides with the existing rantai-agents models. Column names are kept
//     identical to the daemon via @map so the Postgres tables mirror SQLite.
//   * Epoch-ms timestamps and byte sizes are BigInt: SQLite INTEGER is 64-bit
//     and unix-ms (~1.7e12) overflows Postgres 4-byte Int. Small bounded
//     counters/flags/dimensions stay Int. REAL -> Float, BLOB -> Bytes.
//   * JSON-in-TEXT columns are String @db.Text (the port JSON.parses them just
//     like the daemon). Int-boolean flags (enabled/is_active) stay Int to be
//     faithful to the daemon's read path.
//   * Multi-tenancy retrofit: the daemon is single-user, so root-owned entities
//     (no parent FK) gain userId + organizationId + an Organization back-relation;
//     child tables scope through their parent FK (onDelete: Cascade for ownership,
//     SetNull where the daemon declares ON DELETE SET NULL).

model OdProject {
  id                      String  @id
  name                    String
  skillId                 String? @map("skill_id")
  designSystemId          String? @map("design_system_id")
  pendingPrompt           String? @map("pending_prompt") @db.Text
  metadataJson            String? @map("metadata_json") @db.Text
  customInstructions      String? @map("custom_instructions") @db.Text
  appliedPluginSnapshotId String? @map("applied_plugin_snapshot_id")
  createdAt               BigInt  @map("created_at")
  updatedAt               BigInt  @map("updated_at")

  // multi-tenancy retrofit (root-owned)
  userId         String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations         OdConversation[]
  previewComments       OdPreviewComment[]
  tabs                  OdTab[]
  tabsState             OdTabsState?
  deployments           OdDeployment[]
  critiqueRuns          OdCritiqueRun[]
  appliedSnapshots      OdAppliedPluginSnapshot[]
  genuiSurfaces         OdGenuiSurface[]
  skillPluginCandidates OdSkillPluginCandidate[]
  mediaTasks            OdMediaTask[]

  @@index([userId])
  @@index([organizationId])
  @@map("od_projects")
}

model OdTemplate {
  id              String  @id
  name            String
  description     String? @db.Text
  sourceProjectId String? @map("source_project_id")
  filesJson       String  @map("files_json") @db.Text
  createdAt       BigInt  @map("created_at")

  // multi-tenancy retrofit (root-owned; source_project_id is a soft ref, no FK)
  userId         String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("od_templates")
}

model OdConversation {
  id                      String  @id
  projectId               String  @map("project_id")
  title                   String?
  sessionMode             String  @default("design") @map("session_mode")
  appliedPluginSnapshotId String? @map("applied_plugin_snapshot_id")
  createdAt               BigInt  @map("created_at")
  updatedAt               BigInt  @map("updated_at")

  project          OdProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentSessions    OdAgentSession[]
  messages         OdMessage[]
  previewComments  OdPreviewComment[]
  critiqueRuns     OdCritiqueRun[]
  appliedSnapshots OdAppliedPluginSnapshot[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@map("od_conversations")
}

model OdAgentSession {
