{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cloud/*": [
        "./src/cloud-shim/*"
      ],
      "@open-design/components": [
        "./src/design/packages/components/src/index.ts"
      ],
      "@open-design/components/*": [
        "./src/design/packages/components/src/*"
      ],
      "@open-design/contracts": [
        "./src/design/packages/contracts/src/index.ts"
      ],
      "@open-design/contracts/*": [
        "./src/design/packages/contracts/src/*"
      ],
      "@open-design/host": [
        "./src/design/packages/host/src/index.ts"
      ],
      "@open-design/host/*": [
        "./src/design/packages/host/src/*"
      ],
      "@open-design/platform": [
        "./src/design/packages/platform/src/index.ts"
      ],
      "@open-design/sidecar": [
        "./src/design/packages/sidecar/src/index.ts"
      ],
      "@open-design/sidecar-proto": [
        "./src/design/packages/sidecar-proto/src/index.ts"
      ],
      "@open-design/release": [
        "./src/design/packages/release/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "komdigi-chat"
  ]
}
