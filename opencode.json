{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "git commit * --no-verify*": "deny",
      "git commit --no-verify*": "deny",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "rm -rf*": "ask"
    }
  }
}
