# IKAT-Bench corpus artifacts: large OCR caches, figure crops and run outputs.
# Regenerate with tests/bench-kb/src/ikat/extract-corpus.ts (idempotent).
tests/bench-kb/corpus/raw/
tests/bench-kb/corpus/figures/
tests/bench-kb/corpus/built/
tests/bench-kb/corpus/descriptions/
tests/bench-kb/corpus/results/
tests/bench-kb/corpus/embed-cache/
tests/bench-kb/corpus/structural-analysis.json
tests/bench-kb/corpus/corpus-stats.json
tests/bench-kb/corpus/questions.json

# IKAT-Bench: on-premise corpus artifacts (regenerable)
tests/bench-kb/corpus/ugm-built/
tests/bench-kb/corpus/ugm-figures/
tests/bench-kb/corpus/ugm-raw/
tests/bench-kb/corpus/structural-analysis-*.json

# Annotation package: 384 full-resolution crops plus the 11.5 MB self-contained
# build. Regenerate with export-annotation.ts; the KEY and the task source are
# tracked because those are what make a returned answer file scoreable.
tests/bench-kb/corpus/annotation/images/
tests/bench-kb/corpus/annotation/annotation-selfcontained.html
tests/bench-kb/corpus/annotation/annotation.html

# Scaled annotation crops: 912 full-resolution PNGs plus their downscaled JPEGs.
# Regenerate with export-annotation.ts; the KEY, the manifest and the judgements
# are tracked because those are what make the gold reproducible.
tests/bench-kb/corpus/annotation-big/images/
tests/bench-kb/corpus/annotation-big/small/
tests/bench-kb/corpus/annotation-big/annotation.html

# Bench corpus images are extraction output, never source — always regenerable
# via tests/bench-kb/src/ikat/extract-corpus.ts. The per-directory rules above
# enumerate directories by name, so they missed `ugm3-figures/`, `mmdocrag/` and
# `annotation-scale/`; 16.5k crops (~4.7 GB) were then swept into a commit whose
# stated purpose was a two-file vector-store fix. Matching by extension means a
# new corpus directory cannot reintroduce this. No image under corpus/ has ever
# been tracked, so this ignores nothing that was source.
tests/bench-kb/corpus/**/*.jpg
tests/bench-kb/corpus/**/*.jpeg
tests/bench-kb/corpus/**/*.png
tests/bench-kb/corpus/**/*.webp
tests/bench-kb/corpus/**/*.zip
